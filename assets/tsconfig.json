// Phoenix JS packages come from the Hex deps (../deps/*), not from npm.
// `bun build` honors these `paths`, and editors use them for autocompletion.
// UI packages from npm (topbar, ...) resolve from node_modules as usual.
{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "phoenix": ["../deps/phoenix"],
      "phoenix_html": ["../deps/phoenix_html"],
      "phoenix_live_view": ["../deps/phoenix_live_view"]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": ["js/**/*"]
}
