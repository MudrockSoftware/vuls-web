{
  "name": "vulsweb-assets",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "bun run build:css && bun run build:js && bun run build:fonts",
    "build:css": "tailwindcss --input=css/app.css --output=../priv/static/assets/css/app.css",
    "build:js": "bun build js/app.js --outdir=../priv/static/assets/js --target=browser --sourcemap=inline",
    "build:fonts": "mkdir -p ../priv/static/fonts && cp node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 node_modules/@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2 node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2 node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2 ../priv/static/fonts/",
    "watch:css": "tailwindcss --input=css/app.css --output=../priv/static/assets/css/app.css --watch=always",
    "watch:js": "bun build js/app.js --outdir=../priv/static/assets/js --target=browser --sourcemap=inline --watch",
    "deploy": "tailwindcss --input=css/app.css --output=../priv/static/assets/css/app.css --minify && bun build js/app.js --outdir=../priv/static/assets/js --target=browser --minify && bun run build:fonts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "daisyui": "^5.8.2",
    "lucide-static": "^1.73.0",
    "tailwindcss": "^4.3.5",
    "topbar": "^3.0.1"
  },
  "//": "Phoenix JS (phoenix, phoenix_html, phoenix_live_view) is resolved from ../deps via tsconfig.json paths, not installed from npm."
}
